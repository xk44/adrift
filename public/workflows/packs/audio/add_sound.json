{
  "_meta": {
    "title": "Add sound to a clip (MMAudio)",
    "description": "Video-to-audio foley: kijai/ComfyUI-MMAudio with MMAudio large 44k v2 fp16 + synchformer + DFN5B CLIP + 44k VAE/BigVGAN (models/mmaudio; weights CC-BY-NC-4.0, non-commercial). LoadVideo -> Video Slice (length cap) -> GetVideoComponents keeps the source frames and fps for the output. VHS_LoadVideo re-reads the same clip at 25 fps (MMAudio's sync rate) with a matching frame cap for conditioning. MMAudioSampler (25 steps, cfg 4.5) -> CreateVideo muxes the generated audio over the source frames (any source audio is replaced) -> SaveVideo. Builder: src/lib/oj/voiceSound.ts sets the clip, prompt, negative prompt, seed and duration (clip length, capped at 10 s)."
  },
  "1": {
    "class_type": "LoadVideo",
    "inputs": { "file": "" },
    "_meta": { "title": "Source Clip" }
  },
  "2": {
    "class_type": "Video Slice",
    "inputs": {
      "video": ["1", 0],
      "start_time": 0.0,
      "duration": 10.0,
      "strict_duration": false
    },
    "_meta": { "title": "Cap Length" }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": { "video": ["2", 0] },
    "_meta": { "title": "Source Frames" }
  },
  "4": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "",
      "force_rate": 25.0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 250,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "None"
    },
    "_meta": { "title": "Clip at 25 fps (conditioning)" }
  },
  "5": {
    "class_type": "MMAudioModelLoader",
    "inputs": {
      "mmaudio_model": "mmaudio_large_44k_v2_fp16.safetensors",
      "base_precision": "fp16"
    },
    "_meta": { "title": "MMAudio Model" }
  },
  "6": {
    "class_type": "MMAudioFeatureUtilsLoader",
    "inputs": {
      "vae_model": "mmaudio_vae_44k_fp16.safetensors",
      "synchformer_model": "mmaudio_synchformer_fp16.safetensors",
      "clip_model": "apple_DFN5B-CLIP-ViT-H-14-384_fp16.safetensors",
      "mode": "44k",
      "precision": "fp16"
    },
    "_meta": { "title": "MMAudio Feature Utils" }
  },
  "7": {
    "class_type": "MMAudioSampler",
    "inputs": {
      "mmaudio_model": ["5", 0],
      "feature_utils": ["6", 0],
      "duration": 10.0,
      "steps": 25,
      "cfg": 4.5,
      "seed": 0,
      "prompt": "",
      "negative_prompt": "",
      "mask_away_clip": false,
      "force_offload": true,
      "images": ["4", 0]
    },
    "_meta": { "title": "MMAudio Sampler" }
  },
  "8": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["3", 0],
      "fps": ["3", 2],
      "audio": ["7", 0]
    },
    "_meta": { "title": "Mux Video + Sound" }
  },
  "9": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["8", 0],
      "filename_prefix": "video/CJ_AddSound",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": { "title": "Save Video" }
  }
}
