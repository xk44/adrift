{
  "_meta": {
    "title": "Remove video background: one named subject (MatAnyone2)",
    "description": "SAM 3.1 looks for the named subject across the clip and seeds from the first frame it is clear in; MatAnyone2 (FuouM/ComfyUI-MatAnyone, weights under the non-commercial S-Lab License 1.0) propagates that mask into a soft matte for the clip. The background is filled with a solid chroma colour (mp4 via SaveVideo, source audio + fps) or cut out to an RGBA animated PNG; the graph carries both branches and the builder drops the unused one. No sampler or seed."
  },
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": ""
    },
    "_meta": {
      "title": "Source Video"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Frames + Audio + FPS"
    }
  },
  "3": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Source size + frame count"
    }
  },
  "4": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "min(c, max(1, 995328000 // (a * b)))",
      "values.a": [
        "3",
        0
      ],
      "values.b": [
        "3",
        1
      ],
      "values.c": [
        "3",
        2
      ]
    },
    "_meta": {
      "title": "Frame cap: RAM (480 frames at 1080p)"
    }
  },
  "5": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "2",
        0
      ],
      "batch_index": 0,
      "length": [
        "4",
        1
      ]
    },
    "_meta": {
      "title": "Cap clip length"
    }
  },
  "6": {
    "class_type": "CJSampleFrames",
    "inputs": {
      "images": [
        "5",
        0
      ],
      "samples": 32
    },
    "_meta": {
      "title": "Look through the clip"
    }
  },
  "7": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sam3.1_multiplex_fp16.safetensors"
    },
    "_meta": {
      "title": "SAM 3.1"
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "7",
        1
      ],
      "text": "person"
    },
    "_meta": {
      "title": "Subject"
    }
  },
  "9": {
    "class_type": "SAM3_Detect",
    "inputs": {
      "model": [
        "7",
        0
      ],
      "image": [
        "6",
        0
      ],
      "conditioning": [
        "8",
        0
      ],
      "threshold": 0.35,
      "refine_iterations": 2,
      "individual_masks": true
    },
    "_meta": {
      "title": "Find the subject"
    }
  },
  "10": {
    "class_type": "CJFindSubjectFrame",
    "inputs": {
      "masks": [
        "9",
        0
      ],
      "bboxes": [
        "9",
        1
      ],
      "step": [
        "6",
        1
      ]
    },
    "_meta": {
      "title": "Frame the subject is first clear in"
    }
  },
  "11": {
    "class_type": "MatAnyone2",
    "inputs": {
      "src_video": [
        "5",
        0
      ],
      "mask_frame": [
        "10",
        1
      ],
      "n_warmup": 10,
      "foreground_MASK": [
        "10",
        0
      ],
      "max_internal_size": 1080
    },
    "_meta": {
      "title": "MatAnyone2 matte"
    }
  },
  "12": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "11",
        0
      ],
      "channel": "red"
    },
    "_meta": {
      "title": "Matte as mask"
    }
  },
  "13": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "12",
        0
      ]
    },
    "_meta": {
      "title": "Background mask"
    }
  },
  "14": {
    "class_type": "EmptyImage",
    "inputs": {
      "width": 64,
      "height": 64,
      "batch_size": 1,
      "color": 65280
    },
    "_meta": {
      "title": "Chroma fill"
    }
  },
  "15": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "5",
        0
      ],
      "source": [
        "14",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": true,
      "mask": [
        "13",
        0
      ]
    },
    "_meta": {
      "title": "Fill the background"
    }
  },
  "16": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "15",
        0
      ],
      "fps": [
        "2",
        2
      ],
      "audio": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "Mux Video (source fps + audio)"
    }
  },
  "17": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "16",
        0
      ],
      "filename_prefix": "video/CJ_SubjectMatte",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save Video"
    }
  },
  "18": {
    "class_type": "JoinImageWithAlpha",
    "inputs": {
      "image": [
        "5",
        0
      ],
      "alpha": [
        "13",
        0
      ]
    },
    "_meta": {
      "title": "Cut out"
    }
  },
  "19": {
    "class_type": "SaveAnimatedPNG",
    "inputs": {
      "images": [
        "18",
        0
      ],
      "fps": [
        "2",
        2
      ],
      "compress_level": 4,
      "filename_prefix": "video/CJ_SubjectMatte_alpha"
    },
    "_meta": {
      "title": "Save Animated PNG"
    }
  }
}
