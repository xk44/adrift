{
  "_meta": {
    "title": "Light Migration (Qwen-Image-Edit-2509)",
    "description": "Relight mode 'Match a reference': copies the lighting and color tone of a reference photo onto the subject photo. Core ComfyUI Qwen-Image-Edit-2509 + dx8152 Light-Migration LoRA (comfy.org workflow 4a4da321a45d, flattened): subject LoadImage -> ImageScaleToTotalPixels (1MP, multiple of 16); light reference LoadImage -> ImageScaleToTotalPixels (1MP) -> TextEncodeQwenImageEditPlus without VAE (image1 = subject, image2 = light reference; positive = the LoRA's fixed Chinese instruction, optional details appended after it; negative empty) -> ReferenceLatent x2 (subject then light-reference VAEEncode, appended in that order, same as the encoder-with-VAE path but exact-size like relight.json) -> UNETLoader -> Lightning 4-step LoRA -> Light-Migration LoRA (1.0) -> ModelSamplingAuraFlow (shift 3) -> CFGNorm -> KSampler (4 steps, cfg 1, euler/simple; the template's own fp8 + 4-step setting) -> VAEDecode -> CJImagePasteBack (diff-only, no colour match, protect = SAM3 'face' with protect_mode relight: each face keeps the subject's detail under the new light) -> SaveImage. Paste-back can be turned off (params.faceDetail 'model'). The builder (src/lib/oj/lightMigration.ts) sets both images, the prompt and the seed. Models: diffusion_models/qwen_image_edit_2509_fp8_e4m3fn.safetensors, loras/Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors + loras/Qwen-Image-Edit-2509-Light-Migration.safetensors (dx8152), text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors (CLIP type qwen_image), vae/qwen_image_vae.safetensors, checkpoints/sam3.1_multiplex_fp16.safetensors."
  },
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "" },
    "_meta": { "title": "Load Subject Image" }
  },
  "2": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": ["1", 0],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 16
    },
    "_meta": { "title": "Subject at 1MP (multiple of 16)" }
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": { "image": "" },
    "_meta": { "title": "Load Lighting Image" }
  },
  "4": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": ["3", 0],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 16
    },
    "_meta": { "title": "Light reference at 1MP" }
  },
  "5": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_edit_2509_fp8_e4m3fn.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Qwen-Image-Edit-2509" }
  },
  "6": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["5", 0],
      "lora_name": "Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors",
      "strength_model": 1
    },
    "_meta": { "title": "Lightning 4-step LoRA" }
  },
  "7": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["6", 0],
      "lora_name": "Qwen-Image-Edit-2509-Light-Migration.safetensors",
      "strength_model": 1
    },
    "_meta": { "title": "Light Migration LoRA" }
  },
  "8": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "model": ["7", 0], "shift": 3 },
    "_meta": { "title": "Model Sampling (shift 3)" }
  },
  "9": {
    "class_type": "CFGNorm",
    "inputs": { "model": ["8", 0], "strength": 1 },
    "_meta": { "title": "CFG Norm" }
  },
  "10": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "type": "qwen_image",
      "device": "default"
    },
    "_meta": { "title": "Qwen2.5-VL Text Encoder" }
  },
  "11": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" },
    "_meta": { "title": "Qwen Image VAE" }
  },
  "12": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": {
      "clip": ["10", 0],
      "image1": ["2", 0],
      "image2": ["4", 0],
      "prompt": "参考色调，移除图1原有的光照并参考图2的光照和色调对图1重新照明"
    },
    "_meta": { "title": "Positive (light migration prompt)" }
  },
  "13": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": {
      "clip": ["10", 0],
      "image1": ["2", 0],
      "image2": ["4", 0],
      "prompt": ""
    },
    "_meta": { "title": "Negative" }
  },
  "14": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["2", 0], "vae": ["11", 0] },
    "_meta": { "title": "Encode Subject" }
  },
  "15": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["4", 0], "vae": ["11", 0] },
    "_meta": { "title": "Encode Light Reference" }
  },
  "16": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["12", 0], "latent": ["14", 0] },
    "_meta": { "title": "Reference 1: subject (positive)" }
  },
  "17": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["16", 0], "latent": ["15", 0] },
    "_meta": { "title": "Reference 2: light (positive)" }
  },
  "18": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["13", 0], "latent": ["14", 0] },
    "_meta": { "title": "Reference 1: subject (negative)" }
  },
  "19": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["18", 0], "latent": ["15", 0] },
    "_meta": { "title": "Reference 2: light (negative)" }
  },
  "20": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["9", 0],
      "positive": ["17", 0],
      "negative": ["19", 0],
      "latent_image": ["14", 0],
      "seed": 0,
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": { "title": "KSampler (Lightning 4 steps)" }
  },
  "21": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["20", 0], "vae": ["11", 0] },
    "_meta": { "title": "VAE Decode" }
  },
  "22": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sam3.1_multiplex_fp16.safetensors" },
    "_meta": { "title": "SAM3 (face protect)" }
  },
  "23": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["22", 1], "text": "face" },
    "_meta": { "title": "Protect text" }
  },
  "24": {
    "class_type": "SAM3_Detect",
    "inputs": {
      "model": ["22", 0],
      "image": ["2", 0],
      "conditioning": ["23", 0],
      "threshold": 0.3,
      "refine_iterations": 2,
      "individual_masks": false
    },
    "_meta": { "title": "Protect faces (subject)" }
  },
  "25": {
    "class_type": "CJImagePasteBack",
    "inputs": {
      "original": ["2", 0],
      "edited": ["21", 0],
      "protect": ["24", 0],
      "fit": "stretch",
      "diff_thresh": 1.0,
      "reach": 0.18,
      "grow_px": 12,
      "feather_px": 6,
      "min_blob": 0.0,
      "color_match": false,
      "protect_mode": "relight"
    },
    "_meta": { "title": "Keep face detail under the new light" }
  },
  "26": {
    "class_type": "SaveImage",
    "inputs": { "images": ["25", 0], "filename_prefix": "CJ_LightMigration" },
    "_meta": { "title": "Save Image" }
  }
}
