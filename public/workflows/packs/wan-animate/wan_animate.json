{
    "_meta": {
        "title": "Animate Character (Wan Animate 2)",
        "description": "Core ComfyUI nodes only. Motion transfer: the clip's frames drive WanAnimate2ToVideo (pose_video = raw frames, no pose extractor) and the character photo is the reference identity; the output keeps the photo's background. Distilled int8 checkpoint, LCM 10 steps, CFG 1, shift 5, WanAnimate2Cache (cpu/int8 -- gpu OOMs a 24GB card with a desktop on it). Frames are taken 1:1 from the clip (output keeps the clip fps and audio), capped at 241 frames and floored to 4n+1; ContextWindowsManual (21 latent frames, overlap 8) only kicks in past one 81-frame window. The builder (src/lib/oj/wanAnimate.ts) sets inputs/size/seed, swaps to the full checkpoint + lightx2v LoRA for speed=quality, and appends a BiRefNet matte + composite over the original frames for mode=replace."
    },
    "1": {
        "class_type": "LoadVideo",
        "inputs": {
            "file": ""
        },
        "_meta": {
            "title": "Source Clip (motion)"
        }
    },
    "2": {
        "class_type": "GetVideoComponents",
        "inputs": {
            "video": [
                "1",
                0
            ]
        },
        "_meta": {
            "title": "Frames + Audio + FPS"
        }
    },
    "3": {
        "class_type": "ImageFromBatch",
        "inputs": {
            "image": [
                "2",
                0
            ],
            "batch_index": 0,
            "length": 241
        },
        "_meta": {
            "title": "Frame Cap"
        }
    },
    "4": {
        "class_type": "ResizeImageMaskNode",
        "inputs": {
            "input": [
                "3",
                0
            ],
            "resize_type": "scale dimensions",
            "resize_type.width": 480,
            "resize_type.height": 832,
            "resize_type.crop": "center",
            "scale_method": "area"
        },
        "_meta": {
            "title": "Resize Clip"
        }
    },
    "5": {
        "class_type": "GetImageSize",
        "inputs": {
            "image": [
                "4",
                0
            ]
        },
        "_meta": {
            "title": "Clip Size"
        }
    },
    "6": {
        "class_type": "ComfyMathExpression",
        "inputs": {
            "expression": "4 * floor((a - 1) / 4) + 1",
            "values.a": [
                "5",
                2
            ]
        },
        "_meta": {
            "title": "Length 4n+1"
        }
    },
    "7": {
        "class_type": "LoadImage",
        "inputs": {
            "image": ""
        },
        "_meta": {
            "title": "Character Photo"
        }
    },
    "8": {
        "class_type": "ResizeImageMaskNode",
        "inputs": {
            "input": [
                "7",
                0
            ],
            "resize_type": "scale dimensions",
            "resize_type.width": 480,
            "resize_type.height": 832,
            "resize_type.crop": "center",
            "scale_method": "area"
        },
        "_meta": {
            "title": "Resize Character"
        }
    },
    "9": {
