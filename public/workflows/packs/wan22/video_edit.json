{
  "_meta": {
    "title": "Edit video (Lucy Edit Dev)",
    "description": "Core nodes only; no Lucy custom node. Lucy Edit Dev is a Wan2.2 TI2V-5B finetune whose extra 48 input channels take the VAE latent of the source clip: InstructPixToPixConditioning VAE-encodes the frames into concat_latent_image and returns an empty latent of the same shape, which is what the decart LucyConditionConcat node does. The source is trimmed from its start to the window (Video Slice, length/16 s), resampled to 16 fps (VideoFrameSample uniform) and scaled/cropped to ~480p (multiples of 32 for the Wan2.2 VAE). ModelSamplingSD3 shift 5, euler/simple, cfg 5, empty negative (decart example). speed: best 40 steps, balanced 30 (default), fast 20. Length 4n+1 frames (<= 81, 5 s). Source audio is not carried over. License: Lucy Edit Dev weights are non-commercial."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "lucy-edit-dev-cui-fp16.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Lucy Edit Dev"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "split_files/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    },
    "_meta": {
      "title": "umt5 xxl"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan2.2_vae.safetensors"
    },
    "_meta": {
      "title": "Wan 2.2 VAE"
    }
  },
  "4": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": 5.0
    },
    "_meta": {
      "title": "Shift"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": ""
    },
    "_meta": {
      "title": "Edit instruction"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": ""
    },
    "_meta": {
      "title": "Negative"
    }
  },
  "7": {
    "class_type": "InstructPixToPixConditioning",
    "inputs": {
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "pixels": [
        "24",
        0
      ]
    },
    "_meta": {
      "title": "Source latent concat"
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "4",
        0
      ],
      "positive": [
        "7",
        0
      ],
      "negative": [
        "7",
        1
      ],
      "latent_image": [
        "7",
        2
      ],
      "seed": 0,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_meta": {
      "title": "Sampler"
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "10": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "9",
        0
      ],
      "fps": 16
    },
    "_meta": {
      "title": "Video 16 fps"
    }
  },
  "11": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "10",
        0
      ],
      "filename_prefix": "video/CJ_VideoEdit",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save video"
    }
  },
  "20": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": ""
    },
    "_meta": {
      "title": "Source video"
    }
  },
  "21": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "20",
        0
      ],
      "start_time": 0.0,
      "duration": 5.0625,
      "strict_duration": false
    },
    "_meta": {
      "title": "Trim to window"
    }
  },
  "22": {
    "class_type": "VideoFrameSample",
    "inputs": {
      "video": [
        "21",
        0
      ],
      "num_frames": 81,
      "strategy": "uniform",
      "seed": 0
    },
    "_meta": {
      "title": "Resample to 16 fps"
    }
  },
  "23": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "22",
        0
      ]
    },
    "_meta": {
      "title": "Frames"
    }
  },
  "24": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "23",
        0
      ],
      "upscale_method": "area",
      "width": 832,
      "height": 480,
      "crop": "center"
    },
    "_meta": {
      "title": "Fit frames"
    }
  }
}
