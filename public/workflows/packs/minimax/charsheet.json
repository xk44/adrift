{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load MiniMax H3 Ref2VA" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": { "title": "Load Qwen3-VL 32B Encoder" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" },
    "_meta": { "title": "Video VAE" }
  },
  "15": {
    "class_type": "LoadImage",
    "inputs": { "image": "" },
    "_meta": { "title": "Reference 1 (character)" }
  },
  "5": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "",
      "width": 1344,
      "height": 768,
      "length": 5,
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["15", 0]
    },
    "_meta": { "title": "H3 Character Sheet Conditioning (5 frames)" }
  },
  "6": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" },
    "_meta": { "title": "Sampler" }
  },
  "7": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["1", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    },
    "_meta": { "title": "Scheduler" }
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 42 },
    "_meta": { "title": "Noise" }
  },
  "9": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["1", 0], "conditioning": ["5", 0] },
    "_meta": { "title": "Guider" }
  },
  "10": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["9", 0],
      "sampler": ["6", 0],
      "sigmas": ["7", 0],
      "latent_image": ["5", 1]
    },
    "_meta": { "title": "Sample" }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["10", 0], "vae": ["3", 0] },
    "_meta": { "title": "Decode Frames" }
  },
  "12": {
    "class_type": "ImageFromBatch",
    "inputs": { "image": ["11", 0], "batch_index": 0, "length": 1 },
    "_meta": { "title": "Frame 0 = the sheet" }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": { "images": ["12", 0], "filename_prefix": "CJ_H3_CharSheet" },
    "_meta": { "title": "Save Sheet" }
  }
}
