      "video_latent": [
        "11",
        0
      ],
      "audio_latent": [
        "12",
        0
      ]
    },
    "_meta": {
      "title": "AV latent"
    }
  },
  "14": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    },
    "_meta": {
      "title": "Seed"
    }
  },
  "15": {
    "class_type": "KSamplerSelect",
    "inputs": {
