{
  "_meta": {
    "title": "LTX VFX: Exploded View (LoRA XPLDV v5)",
    "description": "Core ComfyUI nodes only (LTX-2.5 support in ComfyUI core). Distilled LTX-2.5 22B (int8), 8 fixed sigmas, euler_ancestral, cfg 1 (LTXVDualCFGGuider 1/1). Image to video: LTXVPreprocess + LTXVImgToVideoInplace(strength 1) pins the product photo as the first frame, single stage at native resolution. DigitalByte XPLDV LoRA (strength 0.5, card default; 0.75 stronger) takes the object apart into an ordered exploded view; prompt follows the card's template (\"... separates into an ordered exploded view ...\"). Trained at 960x544, 121 frames at 24 fps; empty negative per card. No audio. LTX-2.x Community License (ltx-2.x-community-license)."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "LTX-2.5 22B distilled"
    }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora_name": "ltx25/ltx-2.5-xpldv_v5-lora.safetensors",
      "strength_model": 0.5
    },
    "_meta": {
      "title": "XPLDV LoRA"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "Video VAE"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "Audio VAE"
    }
  },
  "6": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    },
    "_meta": {
      "title": "Gemma 4 text encoder"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "6",
        0
      ],
      "text": "The object separates into an ordered exploded view. Its outer parts move outward along controlled paths, revealing the internal components underneath. The parts settle into an organized layered arrangement around the exposed core while retaining their original shapes. The camera holds steady. The lighting from the image remains consistent throughout the continuous shot."
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "6",
        0
      ],
      "text": ""
    },
    "_meta": {
      "title": "Negative"
    }
  },
  "9": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": [
        "7",
        0
      ],
      "negative": [
        "8",
        0
      ],
      "frame_rate": 24.0
    },
    "_meta": {
      "title": "Frame rate"
    }
  },
  "20": {
    "class_type": "LoadImage",
    "inputs": {
      "image": ""
    },
    "_meta": {
      "title": "Product photo"
    }
  },
  "21": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "20",
        0
      ],
      "upscale_method": "lanczos",
      "width": 960,
      "height": 544,
      "crop": "center"
    },
    "_meta": {
      "title": "Fit photo (/32)"
    }
  },
  "22": {
    "class_type": "LTXVPreprocess",
    "inputs": {
      "image": [
        "21",
        0
      ],
      "img_compression": 18
    },
    "_meta": {
      "title": "Preprocess"
    }
  },
  "10": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 960,
      "height": 544,
      "length": 121,
      "batch_size": 1
    },
    "_meta": {
      "title": "Latent size"
    }
  },
  "11": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "vae": [
        "4",
        0
      ],
      "image": [
        "22",
        0
      ],
      "latent": [
        "10",
        0
      ],
      "strength": 1.0,
      "bypass": false
    },
    "_meta": {
      "title": "First frame = photo"
    }
  },
  "12": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "frames_number": 121,
      "frame_rate": 24.0,
      "batch_size": 1,
