  },
  "16": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    },
    "_meta": {
      "title": "Distilled sigmas"
    }
  },
  "17": {
    "class_type": "LTXVDualCFGGuider",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "positive": [
        "9",
        0
      ],
      "negative": [
        "9",
        1
      ],
      "video_cfg": 1.0,
      "audio_cfg": 1.0
    },
    "_meta": {
      "title": "Guider (cfg 1)"
    }
  },
  "18": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "14",
        0
      ],
      "guider": [
        "17",
        0
      ],
      "sampler": [
        "15",
        0
      ],
      "sigmas": [
        "16",
        0
      ],
      "latent_image": [
        "13",
        0
      ]
    },
    "_meta": {
      "title": "Sample"
    }
  },
  "19": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "18",
        0
      ]
