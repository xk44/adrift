  },
  "40": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "19",
        0
      ],
      "vae": [
        "4",
        0
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 16
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "41": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "40",
        0
      ],
      "fps": 24.0
    },
    "_meta": {
      "title": "Video 24 fps"
    }
  },
  "42": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "41",
        0
      ],
      "filename_prefix": "video/CJ_LTXVFX_ExplodedView",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save video"
    }
  }
}
