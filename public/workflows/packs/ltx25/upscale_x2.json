  },
  "42": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "32 * max(2, round(a * min(1, 960 / max(a, b)) / 32))",
      "values.a": [
        "24",
        0
      ],
      "values.b": [
        "24",
        1
      ]
    },
    "_meta": {
      "title": "Source width (/32)"
    }
  },
  "43": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "32 * max(2, round(b * min(1, 960 / max(a, b)) / 32))",
      "values.a": [
        "24",
        0
      ],
      "values.b": [
        "24",
        1
      ]
    },
    "_meta": {
      "title": "Source height (/32)"
    }
  },
  "44": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "2 * a",
      "values.a": [
        "42",
        1
      ]
    },
    "_meta": {
      "title": "Output width"
    }
  },
  "45": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "2 * a",
      "values.a": [
        "43",
        1
      ]
    },
    "_meta": {
      "title": "Output height"
    }
  },
  "50": {
    "class_type": "LTXVContextWindows",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "context_length": 121,
      "context_overlap": 24,
