{
  "_meta": {
    "title": "LTX VFX: Cinemagraph (LoRA Cinemagraph 0.9)",
    "description": "Core ComfyUI nodes only (LTX-2.5 support in ComfyUI core). Distilled LTX-2.5 22B (int8), 8 fixed sigmas, euler_ancestral, cfg 1 (LTXVDualCFGGuider 1/1). Image to video: LTXVPreprocess + LTXVImgToVideoInplace(strength 1) pins the photo as the first frame, single stage at native resolution. Cinemagraph LoRA (trigger CINEMAGRAPH_MOTION, strength 1.1 of the card's 1.0-1.2 sweet spot) animates one element while the rest of the photo stays frozen. Best at 512x704 / 704x512 and 25 frames (card); 49 and 97 frame options. No audio. LTX-2 Community License (ltx-2.x-community-license, gated on Hugging Face)."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "LTX-2.5 22B distilled"
    }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora_name": "ltx25/ltx-2.5-22b-lora-cinemagraph-0.9.safetensors",
      "strength_model": 1.1
    },
    "_meta": {
      "title": "VFX LoRA"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "Video VAE"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "Audio VAE"
    }
  },
  "6": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    },
    "_meta": {
      "title": "Gemma 4 text encoder"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "6",
        0
      ],
      "text": "CINEMAGRAPH_MOTION, tripod locked-off static camera, zero camera movement, only the water moves, everything else stays perfectly still, seamless natural loop"
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "6",
        0
      ],
      "text": "cars moving, camera movement, pan, tilt, zoom, parallax, whole image moving, background sliding, person moving, flicker on entire image, noisy texture, crawling texture, distorted, blurry, low quality"
    },
    "_meta": {
      "title": "Negative"
    }
  },
  "9": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": [
        "7",
        0
      ],
      "negative": [
        "8",
        0
      ],
      "frame_rate": 24.0
    },
    "_meta": {
      "title": "Frame rate"
    }
  },
  "20": {
    "class_type": "LoadImage",
    "inputs": {
      "image": ""
    },
    "_meta": {
      "title": "Source photo"
    }
  },
  "21": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "20",
        0
      ],
      "upscale_method": "lanczos",
      "width": 704,
      "height": 512,
      "crop": "center"
    },
    "_meta": {
      "title": "Fit photo (/32)"
    }
  },
  "22": {
    "class_type": "LTXVPreprocess",
    "inputs": {
      "image": [
        "21",
        0
      ],
      "img_compression": 18
    },
    "_meta": {
      "title": "Preprocess"
    }
  },
  "10": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 704,
      "height": 512,
      "length": 25,
      "batch_size": 1
    },
    "_meta": {
      "title": "Latent size"
    }
  },
  "11": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "vae": [
        "4",
        0
      ],
      "image": [
        "22",
        0
      ],
      "latent": [
        "10",
        0
      ],
      "strength": 1.0,
      "bypass": false
    },
    "_meta": {
      "title": "First frame = photo"
    }
  },
  "12": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "frames_number": 25,
      "frame_rate": 24.0,
      "batch_size": 1,
      "audio_vae": [
        "5",
        0
      ]
    },
    "_meta": {
      "title": "Audio latent"
    }
  },
  "13": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": [
        "11",
        0
      ],
      "audio_latent": [
        "12",
        0
      ]
    },
    "_meta": {
      "title": "AV latent"
    }
  },
  "14": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    },
    "_meta": {
      "title": "Seed"
    }
  },
  "15": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    },
    "_meta": {
      "title": "Sampler"
    }
  },
  "16": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    },
    "_meta": {
      "title": "Distilled sigmas"
    }
  },
  "17": {
    "class_type": "LTXVDualCFGGuider",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "positive": [
        "9",
        0
      ],
      "negative": [
        "9",
        1
      ],
      "video_cfg": 1.0,
      "audio_cfg": 1.0
    },
    "_meta": {
      "title": "Guider (cfg 1)"
    }
  },
  "18": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "14",
        0
      ],
      "guider": [
        "17",
        0
      ],
      "sampler": [
        "15",
        0
      ],
      "sigmas": [
        "16",
        0
      ],
      "latent_image": [
        "13",
        0
      ]
    },
    "_meta": {
      "title": "Sample"
    }
  },
  "19": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "18",
        0
      ]
    },
    "_meta": {
      "title": "Split AV"
    }
  },
  "40": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "19",
        0
      ],
      "vae": [
        "4",
        0
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 16
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "41": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "40",
        0
      ],
      "fps": 24.0
    },
    "_meta": {
      "title": "Video 24 fps"
    }
  },
  "42": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "41",
        0
      ],
      "filename_prefix": "video/CJ_LTXVFX_Cinemagraph",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save video"
    }
  }
}
