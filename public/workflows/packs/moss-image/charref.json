{
  "_meta": {
    "title": "MOSS-Image CharRef (Ostris edit)",
    "description": "7err4 MOSS-Image-CharRef v2 recipe: MOSS-Image BASE + charref LoRA (inserted by the tool) + MOSSImageOstrisEditModelPatch (kv_cache on) + SLG single 22, 50 steps CFG 3 euler/sgm_uniform. Picture 1 = the character reference (scaled to ~1 MP by FluxKontextImageScale; the output takes its size). Negative = empty prompt that still gets the reference. Needs ComfyUI-MOSS-Image-Ostris-Edit, diffusion_models/moss_image_base_bf16.safetensors, loras/moss_image_charref_v2.safetensors."
  },
  "1": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae.safetensors" }
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "moss_image_base_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3.5_9b_bf16.safetensors",
      "type": "moss_image",
      "device": "default"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png", "upload": "image" },
    "_meta": { "title": "Character reference" }
  },
  "5": {
    "class_type": "FluxKontextImageScale",
    "inputs": { "image": ["4", 0] }
  },
  "6": {
    "class_type": "GetImageSize",
    "inputs": { "image": ["5", 0] }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": ["6", 0], "height": ["6", 1], "batch_size": 1 }
  },
  "8": {
    "class_type": "MOSSImageOstrisEditModelPatch",
    "inputs": { "model": ["2", 0], "kv_cache": true }
  },
  "9": {
    "class_type": "SkipLayerGuidanceDiTSimple",
    "inputs": {
      "model": ["8", 0],
      "double_layers": "",
      "single_layers": "22",
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "10": {
    "class_type": "TextEncodeMOSSImageOstrisEdit",
    "inputs": {
      "clip": ["3", 0],
      "prompt": "",
      "vae": ["1", 0],
      "image1": ["5", 0]
    },
    "_meta": { "title": "Positive Prompt" }
  },
  "11": {
    "class_type": "TextEncodeMOSSImageOstrisEdit",
    "inputs": {
      "clip": ["3", 0],
      "prompt": "",
      "vae": ["1", 0],
      "image1": ["5", 0]
    },
    "_meta": { "title": "Negative Prompt" }
  },
  "12": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["9", 0],
      "positive": ["10", 0],
      "negative": ["11", 0],
      "latent_image": ["7", 0],
      "seed": 42,
      "steps": 50,
      "cfg": 3.0,
      "sampler_name": "euler",
      "scheduler": "sgm_uniform",
      "denoise": 1.0
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["12", 0], "vae": ["1", 0] }
  },
  "14": {
    "class_type": "SaveImage",
    "inputs": { "images": ["13", 0], "filename_prefix": "cj_tool_moss_charref" }
  }
}
