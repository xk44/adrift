{
  "_meta": {
    "title": "MOSS-Image SFT I2I",
    "description": "ComfyUI v0.42 MOSS-Image recipe (img2img: LoadImage -> VAEEncode -> KSampler denoise 0.6 instead of an empty latent): 50 steps, CFG 3, euler/sgm_uniform, shift 5, SkipLayerGuidanceDiTSimple on single layer 22 (negative branch). UNTESTED until weights exist. REQUIRES (Comfy-Org repack): diffusion_models/moss_image_sft_bf16.safetensors, text_encoders/qwen3.5_9b_bf16.safetensors (CLIP type moss_image), vae/flux2-vae.safetensors. bf16 only on Apple Silicon."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "moss_image_sft_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3.5_9b_bf16.safetensors",
      "type": "moss_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Positive Prompt"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Negative Prompt"
    }
  },
  "10": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": 5.0
    }
  },
  "11": {
    "class_type": "SkipLayerGuidanceDiTSimple",
    "inputs": {
      "model": [
        "10",
        0
      ],
      "double_layers": "",
      "single_layers": "22",
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "11",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "latent_image": [
        "13",
        0
      ],
      "seed": 42,
      "steps": 50,
      "cfg": 3.0,
      "sampler_name": "euler",
      "scheduler": "sgm_uniform",
      "denoise": 0.6
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "filename_prefix": "cj_moss_image_i2i"
    }
  },
  "12": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png",
      "upload": "image"
    },
    "_meta": {
      "title": "Source Image"
    }
  },
  "13": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "12",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  }
}
