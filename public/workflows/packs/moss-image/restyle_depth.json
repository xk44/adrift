{
  "_meta": {
    "title": "MOSS-Image restyle from depth",
    "description": "Depth Anything 3 depth of the source image (near = white, resized to the output latent size) -> MOSSImageControl depth_map -> MOSS-Image SFT t2i from noise. Needs loras/moss-control.safetensors (darask0 MOSS color/depth control adapter, applied by a LoraLoaderModelOnly the tool inserts) and geometry_estimation/depth_anything_3_base.safetensors. end_percent 1.0 = real-photo maps (adapter README), ~0.5 = keep layout, loosen shapes."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "moss_image_sft_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3.5_9b_bf16.safetensors",
      "type": "moss_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Positive Prompt"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Negative Prompt"
    }
  },
  "6": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "10": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": 5.0
    }
  },
  "11": {
    "class_type": "SkipLayerGuidanceDiTSimple",
    "inputs": {
      "model": [
        "10",
        0
      ],
      "double_layers": "",
      "single_layers": "22",
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "11",
        0
      ],
      "positive": [
        "18",
        0
      ],
      "negative": [
        "18",
        1
      ],
      "latent_image": [
        "6",
        0
      ],
      "seed": 42,
      "steps": 50,
      "cfg": 3.0,
      "sampler_name": "euler",
      "scheduler": "sgm_uniform",
      "denoise": 1
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "filename_prefix": "cj_moss_restyle_depth"
    }
  },
  "12": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png",
      "upload": "image"
    },
    "_meta": {
      "title": "Source image (structure)"
    }
  },
  "14": {
    "class_type": "LoadDA3Model",
    "inputs": {
      "model_name": "depth_anything_3_base.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Depth Anything 3"
    }
  },
  "15": {
    "class_type": "DA3Inference",
    "inputs": {
      "da3_model": [
        "14",
        0
      ],
      "image": [
        "12",
        0
      ],
      "resolution": 504,
      "resize_method": "upper_bound_resize",
      "mode": "mono"
    },
    "_meta": {
      "title": "DA3 depth"
    }
  },
  "16": {
    "class_type": "DA3Render",
    "inputs": {
      "da3_geometry": [
        "15",
        0
      ],
      "output": "depth",
      "output.normalization": "v2_style",
      "output.apply_sky_clip": false
    },
    "_meta": {
      "title": "Depth map (near = white)"
    }
  },
  "17": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "16",
        0
      ],
      "upscale_method": "bilinear",
      "width": 1024,
      "height": 1024,
      "crop": "disabled"
    },
    "_meta": {
      "title": "Depth at output size"
    }
  },
  "18": {
    "class_type": "MOSSImageControl",
    "inputs": {
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "depth_map": [
        "17",
        0
      ],
      "strength": 1.0,
      "start_percent": 0.0,
      "end_percent": 1.0
    },
    "_meta": {
      "title": "MOSS depth control"
    }
  }
}
