{
  "_meta": {
    "title": "Remove Background (BiRefNet)",
    "description": "Core ComfyUI background removal: BiRefNet predicts a foreground mask at the source resolution, InvertMask flips it to ComfyUI's mask convention (JoinImageWithAlpha applies alpha = 1 - mask), JoinImageWithAlpha attaches it, SaveImage writes an RGBA PNG. No sampler, prompt or seed. Model: Comfy-Org/BiRefNet background_removal/birefnet.safetensors in models/background_removal."
  },
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png",
      "upload": "image"
    },
    "_meta": {
      "title": "Source Image"
    }
  },
  "2": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "birefnet.safetensors"
    },
    "_meta": {
      "title": "BiRefNet"
    }
  },
  "3": {
    "class_type": "RemoveBackground",
    "inputs": {
      "bg_removal_model": ["2", 0],
      "image": ["1", 0]
    },
    "_meta": {
      "title": "Foreground Mask"
    }
  },
  "6": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": ["3", 0]
    },
    "_meta": {
      "title": "Mask Convention (1 = transparent)"
    }
  },
  "4": {
    "class_type": "JoinImageWithAlpha",
    "inputs": {
      "image": ["1", 0],
      "alpha": ["6", 0]
    },
    "_meta": {
      "title": "Attach Alpha"
    }
  },
  "5": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["4", 0],
      "filename_prefix": "cj_bg_remove"
    }
  }
}
