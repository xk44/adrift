  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "8",
        1
      ],
      "text": "face"
    },
    "_meta": {
      "title": "Protect text"
    }
  },
  "13": {
    "class_type": "SAM3_Detect",
    "inputs": {
      "model": [
        "8",
        0
      ],
      "image": [
        "4",
        0
      ],
      "conditioning": [
        "12",
        0
      ],
      "threshold": 0.3,
      "refine_iterations": 2,
      "individual_masks": false
    },
    "_meta": {
      "title": "Protect faces"
    }
  },
  "14": {
    "class_type": "CJImagePasteBack",
    "inputs": {
      "original": [
        "4",
        0
      ],
      "edited": [
        "7",
        0
      ],
      "region": [
        "10",
        0
      ],
      "new_content": [
        "11",
        0
      ],
      "protect": [
        "13",
        0
      ],
      "subject": [
        "17",
        0
      ],
      "fit": "crop",
      "diff_thresh": 22.0,
      "reach": 0.18,
      "grow_px": 12,
      "feather_px": 6,
      "min_blob": 0.001,
      "color_match": true
    },
    "_meta": {
      "title": "Paste edit back (full res)"
    }
  },
  "16": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "8",
        1
      ],
      "text": "person"
