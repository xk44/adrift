    "inputs": {
      "model": [
        "8",
        0
      ],
      "image": [
        "4",
        0
      ],
      "conditioning": [
        "16",
        0
      ],
      "threshold": 0.3,
      "refine_iterations": 2,
      "individual_masks": false
    },
    "_meta": {
      "title": "Pose: person on the original (subject)"
