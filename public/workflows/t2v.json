    "_meta": {
      "title": "LTXV Frame Rate Conditioning"
    }
  },
  "6": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 768,
      "height": 512,
      "length": 97,
      "batch_size": 1
    },
    "_meta": {
      "title": "Empty LTXV Latent Video"
    }
  },
  "7": {
    "class_type": "ModelSamplingLTXV",
    "inputs": {
      "model": ["1", 0],
      "max_shift": 2.05,
      "base_shift": 0.95,
      "latent": ["6", 0]
    },
    "_meta": {
      "title": "LTXV Model Sampling"
    }
  },
  "8": {
    "class_type": "LTXVScheduler",
    "inputs": {
      "steps": 25,
      "max_shift": 2.05,
      "base_shift": 0.95,
      "stretch": true,
      "terminal": 0.1,
      "latent": ["6", 0]
    },
    "_meta": {
      "title": "LTXV Scheduler"
    }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_cfg_pp"
    },
    "_meta": {
      "title": "LTXV Sampler"
    }
  },
  "10": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["7", 0],
      "positive": ["5", 0],
      "negative": ["5", 1],
      "cfg": 3
    },
    "_meta": {
      "title": "CFG Guider"
    }
  },
  "11": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    },
    "_meta": {
      "title": "Random Noise"
