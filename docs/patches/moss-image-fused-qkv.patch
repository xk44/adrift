@@ -100,6 +100,17 @@ def load_model_state(
         state = stripped
         if operations is None:
             state, metadata = utils.convert_old_quants(state, "", metadata=metadata)
+    # local patch: ComfyUI-native MOSS checkpoints fuse
+    # layers.N.proj.qkv ([q;k;v] on the out dim, see comfy/ldm/moss_image/model.py);
+    # this module wants split q/k/v. Without this the attention weights stay unloaded
+    # (log: "unet missing ...proj.q.weight") and every sample is pure noise.
+    fused = [k for k in state if k.endswith(".proj.qkv.weight")]
+    if fused:
+        state = dict(state)
+        for key in fused:
+            base = key[: -len("qkv.weight")]
+            for name, part in zip(("q", "k", "v"), state.pop(key).chunk(3, dim=0)):
+                state[f"{base}{name}.weight"] = part
     config = model_config(state)
