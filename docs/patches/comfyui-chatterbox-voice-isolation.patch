+def _audio_digest(audio: Optional[dict]) -> str:
+    """Local patch (Adrift): content digest of an ``AUDIO`` dict ("none" if absent).
+
+    blake2b over ~1 MB of float32 samples is about a millisecond -- noise next
+    to one conversion -- and it is the only identity that is actually safe.
+    """
+    if not isinstance(audio, dict) or audio.get("waveform") is None:
+        return "none"
+    wav = audio["waveform"]
+    h = hashlib.blake2b(digest_size=16)
+    h.update(str((tuple(wav.shape), str(wav.dtype), audio.get("sample_rate"))).encode())
+    h.update(wav.detach().to("cpu").contiguous().numpy().tobytes())
+    return h.hexdigest()
+
