+@_contextlib.contextmanager
+def _keep_builtin_conds(model: Any):
+    """Local patch (Adrift): upstream ``generate(audio_prompt_path=...)`` and
+    ``generate(target_voice_path=...)`` overwrite ``model.conds`` /
+    ``model.ref_dict`` for good, so a later run with no reference clip speaks
+    in the LAST cloned voice instead of the pack's built-in one (one user's
+    clone leaks into another's stock run). Restore both after every call."""
+    saved = {a: getattr(model, a) for a in ("conds", "ref_dict") if hasattr(model, a)}
+    try:
+        yield
+    finally:
+        for attr, value in saved.items():
+            try:
+                setattr(model, attr, value)
+            except Exception:
+                pass
+
+
