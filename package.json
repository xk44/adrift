{
  "name": "adrift-web",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Open-source creative studio for ComfyUI: one web app for image, edit, video, 3D and audio tools on open-weight models, each tool a plain ComfyUI workflow.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xk44/adrift.git"
  },
  "homepage": "https://github.com/xk44/adrift#readme",
  "bugs": {
    "url": "https://github.com/xk44/adrift/issues"
  },
  "keywords": [
    "comfyui",
    "stable-diffusion",
    "generative-ai",
    "image-generation",
    "video-generation",
    "open-weights",
    "nextjs",
    "self-hosted",
    "higgsfield-alternative"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "node scripts/serve.mjs start",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "docs:tools": "UPDATE_TOOLS_DOC=1 vitest run src/__tests__/toolsDoc.test.ts",
    "docs:models": "UPDATE_MODELS_DOC=1 vitest run src/__tests__/modelsDoc.test.ts src/__tests__/modelsToolMap.test.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "build:deploy": "next build"
  },
  "dependencies": {
    "@google/model-viewer": "4.4.0",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.400.0",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.34.5",
    "three": "0.183.2",
    "uuid": "^9.0.1",
    "zod": "^3.24.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.27.7": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
