# Copy to docker/.env (next to docker-compose.yml) and edit.
# Compose reads this file for variable substitution; nothing here is baked
# into the images except COMFY_PUBLIC_WS / CJ_FRAME_ANCESTORS / CJ_DEFAULT_PACK
# (Adrift build args).

# ComfyUI mode: gpu (NVIDIA, needs nvidia-container-toolkit) or cpu (--cpu).
COMPOSE_PROFILES=gpu

# Address Adrift's port binds to. 127.0.0.1 = this machine only; use the
# host's LAN IP to reach it from other machines (then ADMIN_API_KEY below is
# required). Never 0.0.0.0 on a host reachable from the internet.
BIND_ADDR=127.0.0.1
# Address ComfyUI's port binds to. ComfyUI has no login: anyone who reaches
# this port can run any graph. Keep it on 127.0.0.1 (Adrift reaches ComfyUI
# inside the stack and does not need it published).
COMFY_BIND_ADDR=127.0.0.1
ADRIFT_PORT=3044
COMFY_PORT=8188

# How the browser reaches the stack (must match BIND_ADDR/ports).
# ADRIFT_PUBLIC_URL is ComfyUI's allowed CORS/WebSocket origin.
# COMFY_PUBLIC_WS is the live-progress socket; a browser on another machine
# cannot reach a loopback ComfyUI, so jobs there finish by polling instead
# (no live step previews) unless a reverse proxy serves ComfyUI's /ws (see
# docs/SETUP.md, "Using Adrift from other devices").
ADRIFT_PUBLIC_URL=http://127.0.0.1:3044
COMFY_PUBLIC_WS=ws://127.0.0.1:8188

# Host paths. Models use the standard ComfyUI layout
# (diffusion_models/, loras/, vae/, text_encoders/, ...).
COMFY_MODELS_DIR=./models
# ComfyUI state: user/ (settings, saved workflows), input/, temp, caches.
COMFY_DATA_DIR=./comfy-data
# Generated images/videos; grows without bound, put it on a big disk.
COMFY_OUTPUT_DIR=./comfy-data/output
# Optional existing model library mounted read-only at /extra-models; map its
# folders in ${COMFY_DATA_DIR}/extra_model_paths.yaml (see README).
COMFY_EXTRA_MODELS_DIR=./extra-models
COMFY_CUSTOM_NODES_DIR=./custom_nodes
ADRIFT_DATA_DIR=./adrift-data

# Path to the repository source (build context), relative to this file.
ADRIFT_SRC=..

# uid:gid the containers run as; must own the data dirs above.
PUID=1000
PGID=1000

# ComfyUI memory flags. Empty = ComfyUI's dynamic VRAM management (default,
# best on 12-16 GB cards with plenty of system RAM). Try "--reserve-vram 1.0"
# if the desktop shares the GPU, "--lowvram" only if big models still OOM.
COMFY_VRAM_ARGS=
COMFY_EXTRA_ARGS=

# Strongly recommended on any shared network: protects Adrift's API.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=
SESSION_SECRET=

# Optional
CJ_DEFAULT_PACK=
CJ_FRAME_ANCESTORS=
