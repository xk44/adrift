{
  "about": "Starter packs for the first-run wizard (src/lib/onboarding/starterPacks.ts) and `node scripts/fetch-models.mjs --pack <id>`. Every file is a row of models/download-list.json (same dest, repo, revision and size; checked by src/__tests__/starterPacks.test.ts). A slot with `options` lists drop-in alternatives (same loader, sibling precision, see src/lib/comfy/modelVariants.ts); the first option is the default and the wizard picks one per GPU with src/lib/models/compat.ts. Licenses come from MODEL_FAMILIES (src/lib/tools/toolsDoc.ts): every file carries its `licenseName` and `licenseUrl` (from src/lib/models/licenseLinks.ts; null = no verified link), each pack carries its main model's, and `licenseNote` says the terms in plain words. A file with `optional: true` is left out of the default download and the fit check; `--use <dest>` fetches it.",
  "version": 1,
  "tiers": {
    "le8": [
      "images-fast",
      "upscale"
    ],
    "12": [
      "images-draft",
      "images-fast",
      "upscale",
      "audio-sfx",
      "audio-sa3"
    ],
    "16": [
      "images-flux3",
      "images-draft",
      "upscale",
      "audio-sfx",
      "audio-sa3",
      "video-light"
    ],
    "24plus": [
      "images-best",
      "edit",
      "upscale",
      "video-light",
      "audio-sfx",
      "audio-sa3"
    ],
    "mac": [
      "images-best",
