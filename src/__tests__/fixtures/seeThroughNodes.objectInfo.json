  "SeeThrough_LoadLayerDiffModel": {
    "input": {
      "required": {
        "model": [
          [
            "layerdifforg/seethroughv0.0.1_marigold",
            "layerdifforg/seethroughv0.0.2_layerdiff3d",
            "layerdifforg/seethroughv0.0.2_layerdiff3d",
            "24yearsold/seethroughv0.0.2_layerdiff3d_nf4"
          ],
          {
            "default": "layerdifforg/seethroughv0.0.2_layerdiff3d",
            "tooltip": "HuggingFace repo ID or local model folder in models/SeeThrough/"
          }
        ]
      },
      "optional": {
        "vae_ckpt": [
          "STRING",
          {
            "default": "",
