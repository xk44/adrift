        "quant_mode": [
          [
            "none",
            "nf4"
          ],
          {
            "default": "none",
            "tooltip": "Quantization mode: 'none' for bf16, 'nf4' for 4-bit NormalFloat quantization (~8GB VRAM). Requires bitsandbytes."
