{
  "SaveAudioMP3": {
    "input": {
      "required": {
        "audio": [
          "AUDIO",
          {}
        ],
        "filename_prefix": [
          "STRING",
          {
            "default": "audio/ComfyUI",
            "multiline": false
          }
        ],
        "quality": [
          "COMBO",
          {
            "default": "V0",
            "multiselect": false,
            "options": [
              "V0",
              "128k",
              "320k"
            ]
          }
        ]
      },
      "hidden": {
        "prompt": [
          "PROMPT"
        ],
        "extra_pnginfo": [
          "EXTRA_PNGINFO"
        ]
      }
    },
    "input_order": {
      "required": [
        "audio",
        "filename_prefix",
        "quality"
      ],
      "hidden": [
        "prompt",
        "extra_pnginfo"
      ]
    },
    "output": [
      "AUDIO"
    ],
    "output_name": [
      "audio"
    ],
    "name": "SaveAudioMP3",
    "category": "audio"
  },
  "VibeVoiceTTS": {
    "input": {
      "required": {
        "model_name": [
          "COMBO",
          {
            "tooltip": "Select the VibeVoice model to use. Standard and realtime TTS models are listed here; official models are downloaded automatically.",
            "default": "VibeVoice-1.5B",
            "multiselect": false,
            "options": [
              "VibeVoice-1.5B",
              "VibeVoice-7B",
              "VibeVoice-Realtime-0.5B"
            ]
          }
        ],
        "text": [
          "STRING",
          {
            "tooltip": "The script for generation. Use '[1]' or 'Speaker 1:' for speakers. Each speaker must be anchored to at least one reference voice; speakers without their own reference are cloned from the provided reference(s). Realtime models are single-speaker and ignore speaker labels.",
            "default": "[1] Hello, this is a cloned voice.\n[2] And this is a generated voice, how cool is that?",
            "multiline": true
          }
        ],
        "quantize_llm_4bit": [
          "BOOLEAN",
          {
            "tooltip": "Quantize the Qwen2.5 LLM to 4-bit NF4 via bitsandbytes. Diffusion head stays BF16/FP32.",
            "default": false,
            "label_on": "Q4 (LLM only)",
            "label_off": "Full precision"
          }
        ],
        "attention_mode": [
          "COMBO",
          {
            "tooltip": "Attention implementation: Eager (safest), SDPA (balanced), Flash Attention 2 (fastest), Sage (quantized)",
            "default": "sdpa",
            "multiselect": false,
            "options": [
              "eager",
              "sdpa",
              "flash_attention_2",
              "sage"
            ]
          }
        ],
        "cfg_scale": [
          "FLOAT",
          {
            "tooltip": "Classifier-Free Guidance scale. Higher values increase adherence to the voice prompt but may reduce naturalness. Recommended: 1.3 for standard models, 1.5-1.8 for realtime models — realtime values below 1.5 repeat syllables instead of speaking the script, and are raised to 1.5 automatically.",
            "default": 1.3,
            "min": 0.1,
            "max": 50,
            "step": 0.05
          }
        ],
        "inference_steps": [
          "INT",
          {
            "tooltip": "Number of diffusion steps for audio generation. More steps can improve quality but take longer. Recommended: 10",
            "default": 10,
            "min": 1,
            "max": 500
          }
        ],
        "seed": [
          "INT",
          {
            "tooltip": "Seed for reproducibility. Set to 0 for a random seed on each run.",
            "default": 42,
            "min": 0,
            "max": 18446744073709552000
          }
        ],
        "do_sample": [
          "BOOLEAN",
          {
            "tooltip": "Enable to use sampling methods (like temperature and top_p) for more varied output. Disable for deterministic (greedy) decoding. Not used by realtime models.",
            "default": true,
            "label_on": "Enabled (Sampling)",
            "label_off": "Disabled (Greedy)"
          }
        ],
        "temperature": [
          "FLOAT",
          {
            "tooltip": "Controls randomness. Higher values make the output more random and creative, while lower values make it more focused and deterministic. Active only if 'do_sample' is enabled.",
            "default": 0.95,
            "min": 0,
            "max": 2,
            "step": 0.01
          }
        ],
        "top_p": [
          "FLOAT",
          {
            "tooltip": "Nucleus sampling (Top-P). The model samples from the smallest set of tokens whose cumulative probability exceeds this value. Active only if 'do_sample' is enabled.",
            "default": 0.95,
            "min": 0,
            "max": 1,
            "step": 0.01
          }
        ],
        "top_k": [
          "INT",
          {
            "tooltip": "Top-K sampling. Restricts sampling to the K most likely next tokens. Set to 0 to disable. Active only if 'do_sample' is enabled.",
            "default": 0,
            "min": 0,
            "max": 500,
            "step": 1
          }
        ],
        "max_new_tokens": [
          "INT",
          {
            "tooltip": "Max generated speech tokens (utterance length budget). 0 = auto: standard models use 2x the prompt length; realtime models size the budget from the script (~2.5 latents per text token, capped at 1024) so a short prompt cannot run into a multi-minute decode. If the voice model exposes a speech-end token, generation stops earlier; raise this if output is cut off, lower it if output is too long.",
            "default": 0,
            "min": 0,
            "max": 8192,
            "step": 1
          }
        ],
        "force_offload": [
          "BOOLEAN",
          {
            "tooltip": "Force model to be offloaded from VRAM after generation. Useful to free up memory between generations but may slow down subsequent runs.",
            "default": false,
            "label_on": "Force Offload",
            "label_off": "Keep in VRAM"
          }
        ],
        "device": [
          "COMBO",
          {
            "tooltip": "Device to run inference on. 'auto' follows ComfyUI's default compute device.",
            "default": "cuda",
            "multiselect": false,
            "options": [
              "cuda",
              "cpu",
              "auto"
            ]
          }
        ],
        "dtype": [
          "COMBO",
          {
            "tooltip": "Data type for model precision. 'auto' selects optimal type for device.",
            "default": "auto",
            "multiselect": false,
            "options": [
              "auto",
              "bf16",
              "fp16",
              "fp32"
            ]
          }
        ],
        "voice_preset": [
          "COMBO",
          {
            "tooltip": "Official cached .pt voice prompt required by realtime models. Place prompts in models/tts/VibeVoice/voices (or another registered vibevoice_voices root). Ignored by standard models.",
            "default": "None",
            "multiselect": false,
            "options": [
              "None",
              "de-Spk0_man",
              "de-Spk1_woman",
              "en-Carter_man",
              "en-Davis_man",
              "en-Emma_woman",
              "en-Frank_man",
              "en-Grace_woman",
              "en-Mike_man",
              "fr-Spk0_man",
              "fr-Spk1_woman",
              "in-Samuel_man",
              "it-Spk0_woman",
              "it-Spk1_man",
              "jp-Spk0_man",
              "jp-Spk1_woman",
              "kr-Spk0_woman",
              "kr-Spk1_man",
              "nl-Spk0_man",
              "nl-Spk1_woman",
              "pl-Spk0_man",
              "pl-Spk1_woman",
              "pt-Spk0_woman",
              "pt-Spk1_man",
              "sp-Spk0_woman",
              "sp-Spk1_man"
            ]
          }
        ]
      },
      "optional": {
        "external_model": [
          "VIBEVOICE_MODEL",
          {
            "tooltip": "Optional externally-loaded VibeVoice model (from the 'Load VibeVoice Model' node). When connected, this overrides the model_name dropdown."
          }
        ],
        "speaker_1_voice": [
          "AUDIO",
          {
            "tooltip": "Reference audio for 'Speaker 1' or '[1]' in the script."
          }
        ],
        "speaker_2_voice": [
          "AUDIO",
          {
            "tooltip": "Reference audio for 'Speaker 2' or '[2]' in the script."
          }
        ],
        "speaker_3_voice": [
          "AUDIO",
          {
            "tooltip": "Reference audio for 'Speaker 3' or '[3]' in the script."
          }
        ],
        "speaker_4_voice": [
          "AUDIO",
          {
            "tooltip": "Reference audio for 'Speaker 4' or '[4]' in the script."
          }
        ]
      }
    },
    "input_order": {
      "required": [
        "model_name",
        "text",
        "quantize_llm_4bit",
        "attention_mode",
        "cfg_scale",
        "inference_steps",
        "seed",
        "do_sample",
        "temperature",
        "top_p",
        "top_k",
        "max_new_tokens",
        "force_offload",
        "device",
        "dtype",
        "voice_preset"
      ],
      "optional": [
        "external_model",
        "speaker_1_voice",
        "speaker_2_voice",
        "speaker_3_voice",
        "speaker_4_voice"
      ]
    },
    "output": [
      "AUDIO"
    ],
    "output_name": [
      "Audio"
    ],
    "name": "VibeVoiceTTS",
    "category": "WMNodes/sound/tts"
  },
  "CJWhisperASR": {
    "input": {
      "required": {
        "audio": [
          "AUDIO"
        ]
      },
      "optional": {
        "language": [
          [
            "auto",
            "english",
            "spanish",
            "french",
            "german",
            "italian",
            "portuguese",
            "dutch",
            "polish",
            "russian",
            "ukrainian",
            "turkish",
            "arabic",
            "hindi",
            "japanese",
            "korean",
            "chinese",
            "indonesian",
            "vietnamese",
            "thai",
            "swedish",
            "greek",
            "czech",
            "romanian",
            "hungarian",
            "hebrew",
            "persian",
            "danish",
            "finnish",
            "norwegian",
            "malay",
            "tagalog"
          ],
          {
            "default": "auto"
          }
        ],
        "task": [
          [
            "transcribe",
            "translate"
          ],
          {
            "default": "transcribe"
          }
        ],
        "model_path": [
          "STRING",
          {
            "default": "whisper/whisper-large-v3-turbo"
          }
        ],
        "return_timestamps": [
          "BOOLEAN",
          {
            "default": true
          }
        ],
        "device": [
          [
            "auto",
            "cuda",
            "cpu"
          ],
          {
            "default": "auto"
          }
        ],
        "keep_loaded": [
          "BOOLEAN",
          {
            "default": false
          }
        ]
      }
    },
    "input_order": {
      "required": [
        "audio"
      ],
      "optional": [
        "language",
        "task",
        "model_path",
        "return_timestamps",
        "device",
        "keep_loaded"
      ]
    },
    "output": [
      "STRING",
      "STRING"
    ],
    "output_name": [
      "transcript",
      "segments_json"
    ],
    "name": "CJWhisperASR",
    "category": "audio/asr"
  }
}
