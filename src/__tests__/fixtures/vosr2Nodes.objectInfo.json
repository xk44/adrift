  "VOSR2Upscale": {
    "input": {
      "required": {
        "model": [
          "VOSR2_MODEL",
          {
            "tooltip": "Loaded VOSR 2.0 bundle."
          }
        ],
        "image": [
          "IMAGE",
          {}
        ],
        "upscale": [
          "INT",
          {
            "tooltip": "Exact output multiplier. VOSR 2.0 was trained on degradations up to 16x, so higher factors are supported, but there's no general quality guarantee above ~4x -- results depend on the specific image and starting/target resolution, not just the factor. Uncapped so you can experiment; use tiling for large outputs.",
            "default": 4,
            "min": 1,
            "max": 9223372036854775807
          }
        ],
        "seed": [
          "INT",
          {
            "tooltip": "Initial latent-noise seed.",
            "default": 42,
            "min": 0,
            "max": 9223372036854775807,
            "control_after_generate": "fixed"
          }
        ],
        "color_alignment": [
          "COMBO",
          {
            "default": "wavelet",
            "multiselect": false,
            "options": [
              "wavelet",
              "adain",
              "none"
            ]
          }
        ],
        "tile_size": [
          "INT",
          {
            "tooltip": "DiT pixel tile size; 0 disables tiling. VOSR 2.0 was trained natively at up to 512px, so tiling is required (e.g. 512) whenever the upscaled output exceeds 512x512 -- otherwise quality degrades.",
            "default": 0,
            "min": 0,
            "max": 4096,
            "step": 64
          }
        ],
        "tile_overlap": [
          "INT",
          {
            "default": 32,
            "min": 0,
            "max": 512,
            "step": 8
          }
        ],
        "vae_tile_size": [
          "INT",
          {
            "tooltip": "VAE pixel tile size; 0 disables VAE tiling and decodes the full image in one pass regardless of tile_size -- a common source of CUDA OOM once the upscaled output goes much past 1024px. Set a nonzero value (e.g. 1024) for large outputs.",
            "default": 0,
            "min": 0,
            "max": 8192,
            "step": 64
          }
        ],
        "vae_tile_overlap": [
          "INT",
          {
            "default": 32,
            "min": 0,
            "max": 512,
            "step": 8
          }
        ]
      }
    },
    "input_order": {
      "required": [
        "model",
        "image",
        "upscale",
        "seed",
        "color_alignment",
        "tile_size",
        "tile_overlap",
        "vae_tile_size",
        "vae_tile_overlap"
      ]
    },
    "is_input_list": false,
    "output": [
