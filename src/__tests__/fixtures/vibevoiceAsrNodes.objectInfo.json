     {}
    ],
    "times": [
     "INT",
     {
      "default": 1,
      "min": 1,
      "max": 8
     }
    ],
    "gap_seconds": [
     "FLOAT",
     {
      "default": 1.0,
      "min": 0.0,
      "max": 10.0,
      "step": 0.1
     }
    ],
    "copy_seconds": [
     "FLOAT",
     {
      "default": 30.0,
      "min": 0.1,
      "max": 3600.0,
      "step": 0.01
     }
    ]
   }
  },
  "input_order": {
   "required": [
    "audio",
    "times",
    "gap_seconds",
    "copy_seconds"
   ]
  },
  "output": [
   "AUDIO"
  ],
  "output_is_list": [
   false
  ],
  "output_name": [
   "audio"
  ],
  "name": "CJRepeatAudio",
  "display_name": "Repeat Audio (CJ)",
  "description": "",
  "python_module": "custom_nodes.cj_h3_tools",
  "category": "cj_h3_tools/audio",
  "output_node": false
 }
}
