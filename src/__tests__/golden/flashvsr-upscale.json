    "4_scale_clamp": {
      "class_type": "ComfyMathExpression",
      "title": "Scale clamp (1440p)",
      "inputs": {
        "expression": "min(2, 1440 / min(a, b))",
        "values.a": [
          "4_src_size",
          0
        ],
        "values.b": [
          "4_src_size",
          1
        ]
