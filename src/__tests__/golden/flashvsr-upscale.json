    "25": {
      "class_type": "ComfyMathExpression",
      "title": "Frame cap: decode memory (240 frames at 1080p)",
      "inputs": {
        "expression": "min(c, max(1, 497664000 // (a * b)))",
        "values.a": [
          "6",
          0
        ],
        "values.b": [
          "6",
          1
        ],
        "values.c": [
          "6",
          2
        ]
