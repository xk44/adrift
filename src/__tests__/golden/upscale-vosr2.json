          "1",
          0
        ],
        "model": [
          "2",
          0
        ],
        "seed": 7,
        "tile_overlap": 64,
        "tile_size": 512,
        "upscale": 4,
        "vae_tile_overlap": 32,
        "vae_tile_size": 1024
      }
    },
    "4": {
      "class_type": "SaveImage",
      "title": "Save Image",
      "inputs": {
        "filename_prefix": "CJ_VOSR2",
        "images": [
          "3",
          0
        ]
      }
    }
