{
  "name": "upscale_video",
  "tool": "upscale_video",
  "action": "video_upscale",
  "workflow": "packs/utility/video_upscale.json",
  "seed": 7,
  "graph": {
    "1": {
      "class_type": "LoadVideo",
      "title": "Source Video",
      "inputs": {
        "file": "golden_clip.mp4 [input]"
      }
    },
    "2": {
      "class_type": "GetVideoComponents",
      "title": "Frames + Audio + FPS",
      "inputs": {
        "video": [
          "1",
          0
        ]
      }
    },
    "3": {
      "class_type": "UpscaleModelLoader",
      "title": "Upscale model",
      "inputs": {
        "model_name": "RealESRGAN_x4plus.pth"
      }
    },
    "4": {
      "class_type": "ImageUpscaleWithModelBatched",
      "title": "Upscale frames",
      "inputs": {
        "downscale_method": "lanczos",
        "downscale_ratio": 0.5,
        "images": [
          "2",
          0
        ],
        "per_batch": 4,
        "precision": "float32",
        "upscale_model": [
          "3",
          0
        ]
      }
    },
    "6": {
      "class_type": "CreateVideo",
      "title": "Mux Video (source fps + audio)",
      "inputs": {
        "audio": [
          "2",
          1
        ],
        "fps": [
          "2",
          2
        ],
        "images": [
          "4",
          0
        ]
      }
    },
    "7": {
      "class_type": "SaveVideo",
      "title": "Save Video",
      "inputs": {
        "codec": "auto",
        "filename_prefix": "video/CJ_upscale",
        "format": "auto",
        "video": [
          "6",
          0
        ]
      }
    }
  }
}
